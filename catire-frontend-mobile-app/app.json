{
  "expo": {
    "name": "catire-mobile-app",
    "slug": "catire-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.eithermender.catiremobileapp"
    },
    "web": {
      "output": "single",
      "meta": {
        "charset": "utf-8"
      },
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#EC3137",
          "googleServicesFile": "./google-services.json"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que Catire Hot Dog acceda a tu ubicacion para mostrarte la ruta a la sucursal mas cercana."
        }
      ]
    ],
    "scheme": "catire-hotdog",
    "extra": {
      "eas": {
        "projectId": "befbd6e8-1ce1-41f0-9e4c-875d57dd23ea"
      }
    }
  }
}
