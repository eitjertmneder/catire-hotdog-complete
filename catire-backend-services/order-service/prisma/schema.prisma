datasource db {
  provider  = "mongodb"
  url       = env("MONGO_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

model Order {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  user_id      Int
  branch_id    Int?
  is_delivery  Boolean
  notes        String?
  address      Json?
  payment_method String?
  payment_proof  String?
  cancel_reason String?
  items        OrderDetails[]
  reviews      Review[]
  status       OrderStatusType? @default(PENDING)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  deleted_at   DateTime?

  @@map ("orders")
}

model OrderDetails {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  order_id      String   @db.ObjectId
  product_id    Int
  quantity      Int
  base_price    Float
  features      Json[]
  order         Order    @relation(fields: [order_id], references: [id])
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  deleted_at    DateTime?

  @@map ("order_details")
}

model UserAccess {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id        Int
  device_ip      String
  access_error   String?
  accessed_since DateTime @default(now())
  created_at     DateTime @default(now())
  deleted_at     DateTime?

  @@map ("user_access")
}

model Review {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  order_id   String    @db.ObjectId
  user_id    Int
  user_name  String
  rating     Int
  comment    String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  order      Order     @relation(fields: [order_id], references: [id])

  @@unique([order_id, user_id])
  @@map("reviews")
}

enum OrderStatusType {
  PENDING
  PAID
  PREPARING
  READY
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        String   // login_success, login_fail, order_change, inventory, system
  action      String   // What happened
  description String   // Details
  user_email  String?  // Who did it
  user_id     Int?     // User ID if applicable
  branch_id   Int?     // Branch if applicable
  severity    String   // info, warning, success, error
  metadata    Json?    // Extra data
  created_at  DateTime @default(now())

  @@map("audit_logs")
}

enum NameTag {
  SIZE
  TOPPINGS
  TYPE_MEAT
  TYPE_SAUSAGE
  SAUCE
  SODA
}