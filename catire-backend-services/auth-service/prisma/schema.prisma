datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int @id @default(autoincrement())
  role_id         Int
  full_name       String
  email           String @unique
  dni             Int
  phone_1         String
  phone_2         String?
  password        String
  provider        String? @default("local")
  google_id       String? @unique
  firebase_uid   String?    @unique
  avatar_url      String?
  branch_id       Int?
  role            Role @relation(fields: [role_id], references: [id])
  shopping_cars   ShoppingCar[]
  refresh_tokens  RefreshToken[]
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  deleted_at    DateTime?

  @@map ("users")
}

model Role {
  id          Int @id @default(autoincrement())
  name        String @unique
  users       User[]
  permissions Modules[]
  permissions_json Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  @@map ("roles")
}

model ShoppingCar {
  id      Int  @id @default(autoincrement())
  user_id Int
  details Json
  user    User @relation(fields: [user_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  @@map ("shopping_cars")
}

enum Modules {
  Branches
  Menus
  Products
  Users
  Roles
  Orders
  Ingredients
  Purchases
  Reviews
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  user_id    Int
  expires_at DateTime
  created_at DateTime @default(now())
  deleted_at DateTime?
  user       User     @relation(fields: [user_id], references: [id])

  @@map("refresh_tokens")
}

model LoginAttempt {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  count        Int      @default(0)
  locked_until DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("login_attempts")
}